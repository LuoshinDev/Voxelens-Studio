<Window x:Class="ZhuJieJing.App.StudioSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZhuJieJing.App.Localization"
        Title="{loc:Text '设置'}" Icon="Assets/ZhuJieJing.ico"
        Style="{StaticResource {x:Type Window}}"
        Width="710" Height="500" MinWidth="650" MinHeight="460"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="LanguageCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#B99AEF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResourcePath" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border CornerRadius="8" Background="#F8F6FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="PART_ContentHost"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Voxelens Studio" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Text '设置'}" FontSize="20" FontWeight="SemiBold"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{loc:Text '语言文件'}" Click="OpenLanguages_Click" Style="{StaticResource SettingsButton}" Height="26"/>
                            <TextBlock Text="{loc:Text '界面语言'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel x:Name="LanguageChoices"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{loc:Text '材质资源'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                        <TextBlock Text="Minecraft 1.12.2" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="LegacyPath" Style="{StaticResource ResourcePath}"/>
                            <Button Grid.Column="1" Content="{loc:Text '选择'}" Click="ChooseLegacy_Click" Style="{StaticResource SettingsButton}" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Content="{loc:Text '自动查找'}" Click="FindLegacy_Click" Style="{StaticResource SettingsButton}" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="Minecraft 1.13+" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ModernPath" Style="{StaticResource ResourcePath}"/>
                            <Button Grid.Column="1" Content="{loc:Text '选择'}" Click="ChooseModern_Click" Style="{StaticResource SettingsButton}" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Content="{loc:Text '自动查找'}" Click="FindModern_Click" Style="{StaticResource SettingsButton}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,14,0"/>
            <Button Grid.Column="1" Content="{loc:Text '关闭'}" IsCancel="True" Click="Close_Click" Style="{StaticResource SettingsButton}" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Grid.Column="2" Content="{loc:Text '保存资源'}" Style="{StaticResource ExportButtonStyle}" Height="30" Padding="14,0" FontSize="11" FontWeight="SemiBold" Click="Save_Click" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
