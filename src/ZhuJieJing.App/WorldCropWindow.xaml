<Window x:Class="ZhuJieJing.App.WorldCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZhuJieJing.App.Localization"
        xmlns:local="clr-namespace:ZhuJieJing.App"
        Title="{loc:Text '地图裁剪 · 顶层方块卫星图'}"
        Icon="Assets/ZhuJieJing.ico"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CropCoordinateBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="CropMetricCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#F7F3FD" />
            <Setter Property="BorderBrush" Value="#E7DDF4" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Background="#F7F5FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="74" />
        </Grid.RowDefinitions>

        <Border Background="#FCFBFF" BorderBrush="#E8E0F2" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Text '地图裁剪 · 顶层方块卫星图'}" FontSize="18" FontWeight="SemiBold" Foreground="#342B47" />
                </StackPanel>
                <Border Grid.Column="1" Padding="10,5" CornerRadius="10" Background="#EEE7FF" VerticalAlignment="Center">
                    <TextBlock x:Name="CropDimensionPillText" Text="{loc:Text '当前维度'}" FontSize="11" FontWeight="SemiBold" Foreground="#6D43C6" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="306" />
            </Grid.ColumnDefinitions>

            <Border Background="#1F1B27" BorderBrush="#D9CDE8" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <local:WorldCropChunkPlane x:Name="ChunkPlane"
                                               SelectionChanged="ChunkPlane_SelectionChanged" />

                    <Border x:Name="CropPlaneLoadingOverlay"
                            Background="#E61F1B27"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar x:Name="CropPlaneLoadingProgressBar"
                                         Width="260"
                                         IsIndeterminate="True"
                                         Style="{StaticResource StellarProgressBarStyle}" />
                            <TextBlock x:Name="CropPlaneLoadingText"
                                       Text="{loc:Text '正在快速读取 Chunk 边界…'}"
                                       Margin="0,12,0,0"
                                       Foreground="#F1EAF8"
                                       FontSize="12"
                                       MaxWidth="440"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E8E0F2" BorderThickness="1" CornerRadius="12" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{loc:Text '保留范围（Chunk 坐标）'}" FontSize="14" FontWeight="SemiBold" Foreground="#342B47" />

                        <Border Style="{StaticResource CropMetricCardStyle}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text '地形解析并行数'}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#4D3D63" />
                                <TextBlock x:Name="CropLoadConcurrencyText"
                                           Grid.Column="1"
                                           Text="{loc:Text '6 路'}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#6D43C6" />
                                <Slider x:Name="CropLoadConcurrencySlider"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,7,0,0"
                                        Minimum="1"
                                        Maximum="100"
                                        Value="6"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="CropLoadConcurrencySlider_ValueChanged" />
                                <Button x:Name="ApplyCropLoadConcurrencyButton"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Content="{loc:Text '应用并重新解析'}"
                                        Click="ApplyCropLoadConcurrency_Click"
                                        Margin="0,8,0,0"
                                        Height="32"
                                        IsEnabled="False" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Text '最小 Chunk X'}" FontSize="10" Foreground="#7A6C92" />
                                <TextBox x:Name="MinimumChunkXTextBox" Margin="0,4,0,0" Style="{StaticResource CropCoordinateBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Text '最小 Chunk Z'}" FontSize="10" Foreground="#7A6C92" />
                                <TextBox x:Name="MinimumChunkZTextBox" Margin="0,4,0,0" Style="{StaticResource CropCoordinateBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Text 'X 宽度（Chunk）'}" FontSize="10" Foreground="#7A6C92" />
                                <TextBox x:Name="CropWidthTextBox" Margin="0,4,0,0" Style="{StaticResource CropCoordinateBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Text 'Z 深度（Chunk）'}" FontSize="10" Foreground="#7A6C92" />
                                <TextBox x:Name="CropDepthTextBox" Margin="0,4,0,0" Style="{StaticResource CropCoordinateBoxStyle}" />
                            </StackPanel>
                        </Grid>
                        <Button x:Name="ApplyCropCoordinatesButton"
                                Content="{loc:Text '应用坐标微调'}"
                                Click="ApplyCropCoordinates_Click"
                                Margin="0,8,0,0"
                                IsEnabled="False" />
                        <TextBlock x:Name="CropCoordinateValidationText"
                                   Margin="0,5,0,0"
                                   FontSize="10"
                                   Foreground="#C14767"
                                   TextWrapping="Wrap" />

                        <Border Style="{StaticResource CropMetricCardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Text 'Inclusive 边界'}" FontSize="9.5" Foreground="#7A6C92" />
                                <TextBlock x:Name="CropInclusiveBoundsText"
                                           Text="{loc:Text '尚未选择'}"
                                           Margin="0,3,0,0"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11"
                                           Foreground="#4D3D63"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CropMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '将保留'}" FontSize="9.5" Foreground="#7A6C92" />
                                    <TextBlock x:Name="RetainedCropChunkCountText" Text="—" Margin="0,2,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#6D43C6" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CropMetricCardStyle}" Background="#FFF3F5" BorderBrush="#F1D6DD">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '将删除'}" FontSize="9.5" Foreground="#8B6670" />
                                    <TextBlock x:Name="RemovedCropChunkCountText" Text="—" Margin="0,2,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#C14767" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="SpawnConstraintPanel"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                Background="#FFF8E7"
                                BorderBrush="#F1D79E"
                                BorderThickness="1"
                                CornerRadius="9"
                                Visibility="Collapsed">
                            <TextBlock x:Name="SpawnConstraintText"
                                       Text="{loc:Text '主世界选区必须包含世界出生点。'}"
                                       FontSize="10.5"
                                       Foreground="#8C6420"
                                       TextWrapping="Wrap" />
                        </Border>

                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <Button Content="{loc:Text '适合全部'}" Click="FitCropWorld_Click" Margin="0,0,4,0" />
                            <Button Content="{loc:Text '适合选区'}" Click="FitCropSelection_Click" Margin="4,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FCFBFF" BorderBrush="#E8E0F2" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CropFooterStatusText"
                           Text="{loc:Text '正在加载地形…'}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#7A6C92"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Content="{loc:Text '取消'}"
                        Click="CancelCrop_Click"
                        IsCancel="True"
                        Width="90"
                        Height="36"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center" />
                <Button x:Name="StartCropButton"
                        Grid.Column="2"
                        Content="{loc:Text '开始裁剪'}"
                        Click="StartCrop_Click"
                        Width="112"
                        Height="36"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="#CDBCF6" />
            </Grid>
        </Border>
    </Grid>
</Window>
