                                </Viewbox>
                                <TextBlock x:Name="PlanFormatText" Grid.Column="1" Text="{loc:Text '蓝图格式： 版本中立'}" Foreground="#A33A7A" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:Text '当前场景'}" Style="{StaticResource SectionTitle}" Margin="2,18,0,9" />
