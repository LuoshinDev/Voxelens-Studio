                            </Grid>
                        </Border>
                        <Border x:Name="PlanFormatCard" Background="#FFF7FC" CornerRadius="10" Padding="11,9" BorderBrush="#F0D2E7" BorderThickness="1" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="21" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource ToolTitleGlyph}" Stroke="#C4589A" Data="M5,5 H19 V19 H5 Z M8,9 H16 M8,13 H14 M8,17 H12" />
