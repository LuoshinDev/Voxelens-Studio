<Window x:Class="ZhuJieJing.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZhuJieJing.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:renderer="clr-namespace:ZhuJieJing.Renderer.Controls;assembly=ZhuJieJing.Renderer"
        mc:Ignorable="d"
        Title="{loc:Text 'Voxelens Studio'}"
        Icon="Assets/ZhuJieJing.ico"
        Width="1480"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SceneInfoGlyph" TargetType="Path">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="#8EA2BF" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="SceneInfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8296B4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SceneInfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8296B4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="RenderStatusPillStyle" TargetType="Border">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9CCF3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ToolTitleIcon" TargetType="Viewbox">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolTitleGlyph" TargetType="Path">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="#798EAF" />
            <Setter Property="StrokeThickness" Value="1.75" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="RegionFileButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F4EEFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E0D3F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EADFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#BCA0EC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RegionFileListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RegionExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="11"
                                                     Height="11"
                                                     Margin="1,7,0,0"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="Chevron"
                                                          Data="M8,5 L15,12 L8,19"
                                                          Fill="Transparent"
                                                          Stroke="#7F91AA"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <ContentPresenter Grid.Column="1"
                                                              ContentSource="Content"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Data" Value="M5,8 L12,15 L19,8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandedContent"
                                              ContentSource="Content"
                                              Margin="18,0,0,0"
                                              HorizontalAlignment="Stretch"
                                              Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" MinHeight="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FCFBFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="36" Height="36" Source="Assets/ZhuJieJing.png" Stretch="Uniform" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Text 'Voxelens Studio'}"
                               Margin="11,0,12,0"
                               FontWeight="SemiBold"
                               FontSize="17.5"
                               VerticalAlignment="Center" />
                    <Button x:Name="MapFunctionsButton"
                            Click="MapFunctionsButton_Click"
                            IsEnabled="False"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Margin="0,0,10,0"
                            ToolTip="{loc:Text '打开地图裁剪、地图瘦身与 1.12.2 转换'}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4,5 H20 V19 H4 Z M8,5 V19 M16,5 V19 M4,9 H20 M4,15 H20"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{loc:Text '地图工具'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Column="2"
                        MaxWidth="650"
                        MinWidth="260"
                        Margin="18,0"
                        Padding="12,7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F8F5FF"
                        BorderBrush="#E8DFF6"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3,7.5 A2,2 0 0 1 5,5.5 H9 L11,7.5 H19 A2,2 0 0 1 21,9.5 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z"
                                      Fill="Transparent"
                                      Stroke="#8B71B2"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="WorldPathText"
                                   Grid.Column="1"
                                   Text="{loc:Text '未选择文件'}"
                                   Margin="7,0,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="UnifiedOpenButton"
                            Click="UnifiedOpenButton_Click"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="{loc:Text '打开世界、结构或 AI 蓝图'}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="UnifiedOpenMenu"
                                         Placement="Bottom"
                                         Style="{StaticResource StellarContextMenuStyle}">
                                <MenuItem x:Name="AiProjectOpenMenuItem"
                                          Click="OpenAiProject_Click"
                                          Style="{StaticResource StellarMenuItemStyle}">
                                    <MenuItem.Header>
                                        <Grid Width="254">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="#EEE9FF" BorderBrush="#D8CCFA" BorderThickness="1">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M7,7 H17 A3,3 0 0 1 20,10 V17 A3,3 0 0 1 17,20 H7 A3,3 0 0 1 4,17 V10 A3,3 0 0 1 7,7 Z M9,12 H9.1 M15,12 H15.1 M9,16 H15 M12,3 V7"
                                                              Fill="Transparent" Stroke="#7651D2" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Text 'AI 筑界工程'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{loc:Text '实时查看并指挥 AI 施工'}" Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="WorldFolderOpenMenuItem"
                                          Click="OpenWorldFolder_Click"
                                          Style="{StaticResource StellarMenuItemStyle}">
                                    <MenuItem.Header>
                                        <Grid Width="254">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="#F1EBFF" BorderBrush="#E1D5FF" BorderThickness="1">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M3,7.5 A2,2 0 0 1 5,5.5 H9 L11,7.5 H19 A2,2 0 0 1 21,9.5 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z"
                                                              Fill="Transparent" Stroke="#7C3AED" StrokeThickness="1.9" StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Text 'Minecraft 世界文件夹'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{loc:Text '打开 Java 版存档目录'}" Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="SchematicOpenMenuItem"
                                          Click="OpenSchematic_Click"
                                          Style="{StaticResource StellarMenuItemStyle}">
                                    <MenuItem.Header>
                                        <Grid Width="254">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="#FFF0F7" BorderBrush="#F7D9E9" BorderThickness="1">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M12,3 L20,7.5 L12,12 L4,7.5 Z M4,7.5 V16.5 L12,21 L20,16.5 V7.5 M12,12 V21"
                                                              Fill="Transparent" Stroke="#C54891" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Legacy .schematic" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{loc:Text '导入经典 Minecraft 结构文件'}" Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="PlanOpenMenuItem"
                                          Click="OpenPlan_Click"
                                          Style="{StaticResource StellarMenuItemStyle}">
                                    <MenuItem.Header>
                                        <Grid Width="254">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="#F1F0FF" BorderBrush="#DDDAFF" BorderThickness="1">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M4,7 L12,3 L20,7 L12,11 Z M4,12 L12,16 L20,12 M4,17 L12,21 L20,17"
                                                              Fill="Transparent" Stroke="#6956D9" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Text 'AI 蓝图 · .zz'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{loc:Text '打开可编辑的方块施工方案'}" Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3,7.5 A2,2 0 0 1 5,5.5 H9 L11,7.5 H19 A2,2 0 0 1 21,9.5 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.9"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{loc:Text '打开'}" VerticalAlignment="Center" />
                            <TextBlock Text="⌄" Margin="7,-1,0,0" VerticalAlignment="Center" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="UnifiedExportButton" Click="UnifiedExportButton_Click" IsEnabled="False" Style="{StaticResource ExportButtonStyle}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="UnifiedExportMenu"
                                         Placement="Bottom"
                                         Style="{StaticResource StellarContextMenuStyle}">
                                <MenuItem x:Name="OriginalVersionWorldExportMenuItem"
                                          Click="ExportCurrentOriginalVersionWorldFolder_Click"
                                          Visibility="Collapsed"
                                          Style="{StaticResource StellarMenuItemStyle}">
                                    <MenuItem.Header>
                                        <Grid Width="254">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="#EEF7FF" BorderBrush="#D5E9FA" BorderThickness="1">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M3,7.5 A2,2 0 0 1 5,5.5 H9 L11,7.5 H19 A2,2 0 0 1 21,9.5 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z"
                                                              Fill="Transparent" Stroke="#3F78A7" StrokeThickness="1.9" StrokeLineJoin="Round" />
                                                        <Path Data="M16,4 V9 M13.5,6.5 H18.5" Stroke="#3F78A7" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Text '世界文件夹 · 原版本'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{loc:Text '完整复制当前存档版本'}" Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="WorldFolderExportMenuItem"
                                          Click="ExportCurrentWorldFolder_Click"
                                          Style="{StaticResource StellarMenuItemStyle}">
                                    <MenuItem.Header>
                                        <Grid Width="254">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="#F1EBFF" BorderBrush="#E1D5FF" BorderThickness="1">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M12,3 L20,7.5 L12,12 L4,7.5 Z M4,7.5 V16.5 L12,21 L20,16.5 V7.5 M12,12 V21"
                                                              Fill="Transparent" Stroke="#7C3AED" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="WorldFolderExportTitleText" Text="{loc:Text '世界文件夹 · Java 1.12.2'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{loc:Text '可直接放入 saves 使用'}" Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Click="ExportCurrentSchematic_Click" Style="{StaticResource StellarMenuItemStyle}">
                                    <MenuItem.Header>
                                        <Grid Width="254">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="#FFF0F7" BorderBrush="#F7D9E9" BorderThickness="1">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M12,3 V15 M8,11 L12,15 L16,11 M4,17 V20 H20 V17"
                                                              Fill="Transparent" Stroke="#C54891" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Legacy .schematic" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{loc:Text '导出经典 Minecraft 结构文件'}" Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Click="ExportCurrentPlan_Click" Style="{StaticResource StellarMenuItemStyle}">
                                    <MenuItem.Header>
                                        <Grid Width="254">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="#F1F0FF" BorderBrush="#DDDAFF" BorderThickness="1">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M4,7 L12,3 L20,7 L12,11 Z M4,12 L12,16 L20,12 M4,17 L12,21 L20,17"
                                                              Fill="Transparent" Stroke="#6956D9" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Text 'AI 蓝图 · .zz'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{loc:Text '便于 AI 继续设计与修改'}" Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M21,15 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V15 M7,10 L12,15 L17,10 M12,15 V3"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{loc:Text '导出'}" VerticalAlignment="Center" />
                            <TextBlock Text="⌄" Margin="6,-1,0,0" VerticalAlignment="Center" />
