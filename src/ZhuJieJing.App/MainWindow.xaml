                                <Viewbox Grid.Row="1" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource SceneInfoGlyph}" Data="M12,3 A9,9 0 1 1 3,12 A9,9 0 0 1 12,3 Z M8,12 L10.7,14.7 L16.5,8.9" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="DataVersion" Style="{StaticResource SceneInfoLabel}" Margin="0,0,0,8" />
                                <TextBlock x:Name="SceneDataVersionText" Grid.Row="1" Grid.Column="2" Text="—" Style="{StaticResource SceneInfoValue}" Margin="0,0,0,8" />

                                <Viewbox Grid.Row="2" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource SceneInfoGlyph}" Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="SceneCountLabel" Grid.Row="2" Grid.Column="1" Text="{loc:Text '方块数量'}" Style="{StaticResource SceneInfoLabel}" Margin="0,0,0,8" />
                                <TextBlock x:Name="SceneCountText" Grid.Row="2" Grid.Column="2" Text="—" Style="{StaticResource SceneInfoValue}" Margin="0,0,0,8" />

                                <Viewbox Grid.Row="3" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource SceneInfoGlyph}" Data="M9,4 H5 A1,1 0 0 0 4,5 V9 M15,4 H19 A1,1 0 0 1 20,5 V9 M20,15 V19 A1,1 0 0 1 19,20 H15 M9,20 H5 A1,1 0 0 1 4,19 V15" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Text '尺寸'}" Style="{StaticResource SceneInfoLabel}" Margin="0,0,0,8" />
                                <TextBlock x:Name="SceneSizeText" Grid.Row="3" Grid.Column="2" Text="—" Style="{StaticResource SceneInfoValue}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <Viewbox Grid.Row="4" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource SceneInfoGlyph}" Data="M4,4 H11 V11 H4 Z M13,4 H20 V11 H13 Z M4,13 H11 V20 H4 Z M13,13 H20 V20 H13 Z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Text '区块'}" Style="{StaticResource SceneInfoLabel}" Margin="0,0,0,8" />
                                <TextBlock x:Name="SceneChunksText" Grid.Row="4" Grid.Column="2" Text="—" Style="{StaticResource SceneInfoValue}" Margin="0,0,0,8" />

                                <Viewbox Grid.Row="5" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource SceneInfoGlyph}" Data="M12,3 L20,7.5 L12,12 L4,7.5 Z M4,7.5 V16.5 L12,21 L20,16.5 V7.5 M12,12 V21 M16.8,13.5 H19.2" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{loc:Text '方块实体'}" Style="{StaticResource SceneInfoLabel}" Margin="0,0,0,8" />
                                <TextBlock x:Name="SceneBlockEntitiesText" Grid.Row="5" Grid.Column="2" Text="—" Style="{StaticResource SceneInfoValue}" Margin="0,0,0,8" />

                                <Viewbox Grid.Row="6" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource SceneInfoGlyph}" Data="M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M12,7 A5,5 0 1 1 7,12 A5,5 0 0 1 12,7 Z M12,10.5 A1.5,1.5 0 1 1 10.5,12 A1.5,1.5 0 0 1 12,10.5 Z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{loc:Text '坐标原点'}" Style="{StaticResource SceneInfoLabel}" />
                                <TextBlock x:Name="SceneOriginText" Grid.Row="6" Grid.Column="2" Text="—" Style="{StaticResource SceneInfoValue}" />
                            </Grid>
                        </Border>

                        <StackPanel x:Name="RegionFilesSection" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="2,18,0,9">
                                <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource ToolTitleGlyph}" Data="M4,5 H20 V9 H4 Z M4,10.5 H20 V14.5 H4 Z M4,16 H20 V20 H4 Z M7,7 H7.1 M7,12.5 H7.1 M7,18 H7.1" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{loc:Text '区域文件'}" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <Border Background="#FFFFFF" CornerRadius="10" Padding="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <ItemsControl x:Name="RegionDimensionsList"
                                              HorizontalContentAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander IsExpanded="{Binding IsInitiallyExpanded}"
                                                          Style="{StaticResource RegionExpanderStyle}"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch"
                                                          VerticalContentAlignment="Center"
                                                          Margin="0,0,0,5"
                                                          ToolTip="{Binding DirectoryToolTip}">
                                                    <Expander.Header>
                                                        <Grid Margin="2,3,1,3">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Row="0"
                                                                    MinWidth="42"
                                                                    MinHeight="24"
                                                                    Padding="8,3"
                                                                    Background="#F8F5FC"
                                                                    BorderBrush="#E7DDF4"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="{Binding Summary.Dimension.Value}">
                                                                <TextBlock Text="{Binding Summary.LocalizedDisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#625274" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                            </Border>
                                                            <Border Grid.Row="0" Grid.Column="2" MinWidth="52" MinHeight="24" Padding="8,3" Margin="8,0,0,0" Background="#F0E9FF" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Summary.RegionCount, StringFormat={}{0:N0} Region}" FontSize="9.5" FontWeight="SemiBold" Foreground="#7650C5" TextAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Grid.Row="1"
                                                                       Grid.ColumnSpan="3"
                                                                       Text="{Binding Summary.Dimension.Value}"
                                                                       Margin="1,4,1,0"
                                                                       FontSize="9.5"
                                                                       Foreground="#9A8CAC"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ListBox ItemsSource="{Binding Regions}"
                                                             MaxHeight="220"
                                                             Margin="0,3,0,1"
                                                             Padding="0"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             ItemContainerStyle="{StaticResource RegionFileListItemStyle}"
                                                             ScrollViewer.CanContentScroll="True"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             VirtualizingPanel.IsVirtualizing="True"
                                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VirtualizingStackPanel />
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Tag="{Binding}"
                                                                        Click="RegionFile_Click"
                                                                        IsEnabled="{Binding CanNavigate}"
                                                                        Style="{StaticResource RegionFileButtonStyle}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="18" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Viewbox Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,2,0,0">
                                                                            <Canvas Width="24" Height="24">
                                                                                <Path Data="M4,4 H20 V20 H4 Z M12,4 V20 M4,12 H20"
                                                                                      Fill="Transparent" Stroke="#9A7CCD" StrokeThickness="1.7" StrokeLineJoin="Round" />
                                                                            </Canvas>
                                                                        </Viewbox>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="{Binding FileName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#59446F" />
                                                                            <TextBlock Text="{Binding FileSizeText}" Margin="0,1,0,0" FontSize="9.5" Foreground="#9485A5" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AiCollaborationCard"
                                    Visibility="Collapsed"
                                    Margin="0,18,0,0">
                            <Border Background="#FFFFFF" CornerRadius="11" Padding="12" BorderBrush="#DCCEF6" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Style="{StaticResource ToolTitleIcon}">
                                            <Canvas Width="24" Height="24">
                                                <Path Style="{StaticResource ToolTitleGlyph}" Stroke="#7651D2" Data="M7,7 H17 A3,3 0 0 1 20,10 V17 A3,3 0 0 1 17,20 H7 A3,3 0 0 1 4,17 V10 A3,3 0 0 1 7,7 Z M9,12 H9.1 M15,12 H15.1 M9,16 H15 M12,3 V7" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{loc:Text 'AI 施工协作'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="7,3" Background="#F1ECFF" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="AiStatusDot" Width="6" Height="6" Fill="#AFA6BC" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="AiStateText" Text="{loc:Text '未打开工程'}" FontSize="9.5" FontWeight="SemiBold" Foreground="#665375" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Margin="0,8,0,0" Padding="12" Background="#FFFFFF" BorderBrush="#DCCEF6" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '工程状态'}" FontSize="9.5" FontWeight="SemiBold" Foreground="#806A96" />
                                    <TextBlock x:Name="AiStageText"
                                               Text="{loc:Text '工程打开后会自动跟踪增量 revision'}"
                                               Margin="0,7,0,0"
                                               FontSize="10.5"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               LineHeight="14"
                                               TextWrapping="Wrap" />
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar x:Name="AiProgressBar"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="0"
                                                     IsIndeterminate="False"
                                                     Height="6"
                                                     VerticalAlignment="Center"
                                                     Style="{StaticResource StellarProgressBarStyle}" />
                                        <TextBlock x:Name="AiProgressText"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   Margin="9,0,0,0"
                                                   FontSize="9.5"
                                                   Foreground="#7651D2"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="AiStatusAgeText"
                                               Text="{loc:Text '尚未收到 AI 状态'}"
                                               Margin="0,6,0,0"
                                               FontSize="9.5"
                                               Foreground="#9789A6"
                                               LineHeight="13"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,8,0,0" Padding="12" Background="#FFFFFF" BorderBrush="#DCCEF6" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '施工批次'}" FontSize="9.5" FontWeight="SemiBold" Foreground="#806A96" />
                                    <TextBlock x:Name="AiBatchPositionText"
                                               Text="0 / 0"
                                               Margin="0,6,0,7"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="#665375"
                                               LineHeight="14"
                                               TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PreviousAiBatchButton" Grid.Column="0" Content="{loc:Text '上一批'}" Click="PreviousAiBatch_Click" IsEnabled="False" Margin="0,0,4,0" Padding="7,7" FontSize="10.5" />
                                        <Button x:Name="NextAiBatchButton" Grid.Column="1" Content="{loc:Text '下一批'}" Click="NextAiBatch_Click" IsEnabled="False" Margin="4,0,0,0" Padding="7,7" FontSize="10.5" />
                                    </Grid>
                                    <Button x:Name="DeleteAiBatchContentButton"
                                            Content="{loc:Text '删除本批次'}"
                                            ToolTip="{loc:Text '删除当前批次内容'}"
                                            Click="DeleteAiBatchContent_Click"
                                            IsEnabled="False"
                                            Margin="0,7,0,0"
                                            Padding="7,7"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="#B4233A"
                                            Background="#FFF0F2"
                                            BorderBrush="#E9A3AE" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,8,0,0" Padding="12" Background="#FFFFFF" BorderBrush="#DCCEF6" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '最近指令与回执'}" Margin="0,0,0,6" FontSize="9.5" FontWeight="SemiBold" Foreground="#806A96" />
                                    <ItemsControl x:Name="AiInstructionHistoryItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFFFFF" BorderBrush="#EEE7F5" BorderThickness="1" CornerRadius="7" Padding="7,5" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayText}" FontSize="9.5" Foreground="#625274" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayText}" />
                                                            <TextBlock Text="{Binding ReceiptText}" Margin="0,2,0,0" FontSize="8.5" Foreground="#9789A6" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReceiptText}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding StateText}" MinWidth="36" Margin="8,0,0,0" FontSize="9" FontWeight="SemiBold" Foreground="#7A54C7" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Content="{loc:Text '删除'}" Margin="6,0,0,0" Padding="6,2" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{loc:Text '删除尚未被 AI 读取的排队指令'}" Click="DeleteQueuedAiInstruction_Click">
                                                            <Button.Style>
                                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,8,0,0" Padding="12" Background="#FFFFFF" BorderBrush="#DCCEF6" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '指令与控制'}" FontSize="9.5" FontWeight="SemiBold" Foreground="#806A96" />
                                    <TextBox x:Name="AiInstructionTextBox"
                                             MinHeight="58"
                                             MaxHeight="120"
                                             Margin="0,7,0,0"
                                             Padding="8,6"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             IsEnabled="False"
                                             ToolTip="{loc:Text '输入施工指令；Ctrl+Enter 排队，当前工程已有有效预览时附带镜头坐标'}"
                                             PreviewKeyDown="AiInstructionTextBox_PreviewKeyDown" />
                                    <Button x:Name="QueueAiInstructionButton"
                                            Content="{loc:Text '排队给 AI（Ctrl+Enter）'}"
                                            Click="QueueAiInstruction_Click"
                                            IsEnabled="False"
                                            Margin="0,7,0,0"
                                            Background="{StaticResource AccentSoftBrush}"
                                            BorderBrush="#CDBCF6" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PauseAiButton" Grid.Column="0" Content="{loc:Text '暂停'}" Click="PauseAi_Click" IsEnabled="False" Margin="0,0,4,0" />
                                        <Button x:Name="ResumeAiButton" Grid.Column="1" Content="{loc:Text '继续'}" Click="ResumeAi_Click" IsEnabled="False" Margin="4,0,0,0" />
                                    </Grid>
                                    <Button x:Name="CancelAiCurrentButton" Content="{loc:Text '取消当前施工'}" Click="CancelAiCurrent_Click" IsEnabled="False" Margin="0,7,0,0" />
                                    <Button x:Name="OpenAiProjectFolderButton" Content="{loc:Text '打开工程目录'}" Click="OpenAiProjectFolder_Click" IsEnabled="False" Margin="0,7,0,0" />
                                    <Button x:Name="ReloadAiProjectButton" Content="{loc:Text '立即重新载入'}" Click="ReloadAiProject_Click" IsEnabled="False" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="12">
                <Border CornerRadius="13" Background="#E8E4F5" BorderBrush="#DED6ED" BorderThickness="1" ClipToBounds="True">
                    <renderer:VoxelViewport x:Name="Viewport" PreviewMouseLeftButtonDown="InspectionViewport_MouseDown" />
                </Border>
                <StackPanel x:Name="RenderStatusPanel"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="15"
                            Orientation="Horizontal"
                            IsHitTestVisible="False">
                    <Border Style="{StaticResource RenderStatusPillStyle}"
                            Margin="0">
                        <StackPanel Orientation="Horizontal">
