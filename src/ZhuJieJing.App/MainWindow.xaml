                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="XCoordinate" Text="0" ToolTip="X" />
                                    <TextBox x:Name="YCoordinate" Grid.Column="2" Text="1" ToolTip="Y" />
                                    <TextBox x:Name="ZCoordinate" Grid.Column="4" Text="0" ToolTip="Z" />
                                </Grid>
                                <Button x:Name="CoordinateJumpButton" Content="{loc:Text '跳转到坐标'}" Click="JumpToCoordinate_Click" Background="{StaticResource AccentSoftBrush}" BorderBrush="#CDBCF6" Margin="0,9,0,0" />
                                <Button x:Name="SpawnJumpButton" Content="{loc:Text '跳转到出生点'}" Click="JumpToSpawn_Click" IsEnabled="False" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" CornerRadius="11" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Style="{StaticResource ToolTitleIcon}">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource ToolTitleGlyph}" Data="M3,19 L8.5,10 L12,15 L15,8 L21,19 Z M3,19 H21" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{loc:Text '地形'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <UniformGrid Columns="3" Margin="0,9,0,0">
                                    <RadioButton x:Name="ChunksTerrainChoice" GroupName="TerrainMode" Content="{loc:Text '区块'}" IsChecked="True" Style="{StaticResource SegmentChoice}" Checked="TerrainMode_Checked" Margin="0,0,4,0" />
                                    <RadioButton x:Name="SuperflatTerrainChoice" GroupName="TerrainMode" Content="{loc:Text '超平坦'}" Style="{StaticResource SegmentChoice}" Checked="TerrainMode_Checked" Margin="2,0" />
                                    <RadioButton x:Name="TransparentTerrainChoice" GroupName="TerrainMode" Content="{loc:Text '透明'}" Style="{StaticResource SegmentChoice}" Checked="TerrainMode_Checked" Margin="4,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ConversionCard" Visibility="Collapsed" Background="#FFFFFF" CornerRadius="11" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Style="{StaticResource ToolTitleIcon}">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource ToolTitleGlyph}" Data="M5,7 H18 M15,4 L18,7 L15,10 M19,17 H6 M9,14 L6,17 L9,20" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{loc:Text '低版本预览'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <Button x:Name="ConversionPreviewButton" Content="{loc:Text '低版本预览'}" Click="ConversionPreview_Click" IsEnabled="False" Margin="0,0,5,0" />
                                    <Button x:Name="OriginalWorldButton" Content="{loc:Text '原始地图'}" Click="OriginalWorld_Click" IsEnabled="False" Margin="5,0,0,0" />
                                </UniformGrid>
                                <Button x:Name="BlockMappingTableButton"
                                        Click="BlockMappingTable_Click"
                                        IsEnabled="False"
                                        Margin="0,9,0,0"
                                        Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M4,5 H10 V11 H4 Z M14,5 H20 V11 H14 Z M4,15 H10 V21 H4 Z M13,18 H21 M18,15 L21,18 L18,21"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{loc:Text '方块映射表'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" CornerRadius="11" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Style="{StaticResource ToolTitleIcon}">
                                            <Canvas Width="24" Height="24">
                                                <Path Style="{StaticResource ToolTitleGlyph}" Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{loc:Text '区块加载上限'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="LoadedChunkCountText"
                                               Grid.Column="1"
                                               Text="49"
                                               Foreground="#6941C6"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Slider x:Name="LoadedChunkRadiusSlider"
                                        Minimum="1"
                                        Maximum="20"
                                        Value="3"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="LoadedChunkRadiusSlider_ValueChanged"
                                        Margin="0,9,0,0" />
                                <Border Height="1" Margin="0,12,0,11" Background="#EEE8F6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Style="{StaticResource ToolTitleIcon}">
                                            <Canvas Width="24" Height="24">
                                                <Path Style="{StaticResource ToolTitleGlyph}" Data="M7,3 V7 M12,3 V7 M17,3 V7 M7,17 V21 M12,17 V21 M17,17 V21 M3,7 H7 M3,12 H7 M3,17 H7 M17,7 H21 M17,12 H21 M17,17 H21 M7,7 H17 V17 H7 Z M10,10 H14 V14 H10 Z" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{loc:Text '加载线程'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="ChunkLoadConcurrencyText"
                                               Grid.Column="1"
                                               Text="6"
                                               Foreground="#6941C6"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Slider x:Name="ChunkLoadConcurrencySlider"
                                        Minimum="1"
                                        Maximum="100"
                                        Value="6"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ChunkLoadConcurrencySlider_ValueChanged"
                                        Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FCFBFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
            <Grid x:Name="ActiveOperationPanel" Margin="16,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="ActiveOperationStageText" TextTrimming="CharacterEllipsis" FontSize="11"/><ProgressBar x:Name="ActiveOperationProgress" Height="3" Margin="0,5,0,0" Maximum="100" IsIndeterminate="True"/></StackPanel>
                <TextBlock x:Name="ActiveOperationTimeText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <Button x:Name="CancelOperationButton" Grid.Column="2" Content="{loc:Text '取消任务'}" Click="CancelOperation_Click" Padding="12,4"/>
            </Grid>
            <Grid Margin="16,0" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="#59B58B" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="{loc:Text '就绪'}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
            </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
