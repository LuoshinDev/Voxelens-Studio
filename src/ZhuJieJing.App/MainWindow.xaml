                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="21" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource ToolTitleGlyph}" Stroke="#8560D4" Data="M7,4 H15 L20,9 V17 A3,3 0 0 1 17,20 H7 A3,3 0 0 1 4,17 V7 A3,3 0 0 1 7,4 Z M14.5,4 V9.5 H20 M8,14 H16 M8,17 H13" />
