<Window x:Class="ZhuJieJing.App.MapFunctionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZhuJieJing.App.Localization"
        Title="{loc:Text '地图工具 · Voxelens Studio'}"
        Icon="Assets/ZhuJieJing.ico"
        Width="820"
        Height="590"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Closing="MapFunctionsWindow_Closing">
    <Window.Resources>
        <Style x:Key="ReplacementCardStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#FAF8FF" BorderBrush="#E7DFF7" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F0E9FF" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#EDE3FF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#9560EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ReplacementCardTemplate">
            <StackPanel Width="70">
                <Image Source="{Binding Thumbnail}" Width="42" Height="42" Margin="0,3,0,5" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding Quantity}" FontSize="9" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ReplacementCardsPanel"><WrapPanel /></ItemsPanelTemplate>
        <Style x:Key="ReplacementGridStyle" TargetType="ListBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ReplacementCardStyle}" />
            <Setter Property="ItemTemplate" Value="{StaticResource ReplacementCardTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource ReplacementCardsPanel}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        </Style>
        <Style x:Key="MapFunctionNavigationStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F5F0FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#DDD0F4" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#6941C6" />
                                <Setter TargetName="Chrome" Property="Background" Value="#EEE7FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#C9B4F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MapFunctionNoticeStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#FFF8EB" />
            <Setter Property="BorderBrush" Value="#F1D69C" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="MapFunctionSectionCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Background="#FCFBFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Text '地图工具'}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Padding="11,6"
                        CornerRadius="10"
                        Background="#EEE7FF"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="WorldContextStateText"
                                   Text="{loc:Text '未挂载地图'}"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#6D43C6" />
                        <TextBlock x:Name="WorldContextText"
                                   Text="{loc:Text '请先打开 Minecraft 世界'}"
                                   Margin="0,2,0,0"
                                   MaxWidth="260"
                                   HorizontalAlignment="Right"
                                   FontSize="10.5"
                                   Foreground="#765A9E"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FBFAFE" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="14,16">
                    <TextBlock Text="{loc:Text '工具菜单'}"
                               Margin="4,0,0,10"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <RadioButton x:Name="CropNavigationButton"
                                 GroupName="MapFunctionSection"
                                 IsChecked="True"
                                 Click="CropNavigation_Click"
                                 Style="{StaticResource MapFunctionNavigationStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text '地图裁剪'}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Text '框选矩形保留区域'}"
                                       Margin="0,3,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SlimmingNavigationButton"
                                 GroupName="MapFunctionSection"
                                 Click="SlimmingNavigation_Click"
                                 Style="{StaticResource MapFunctionNavigationStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text '地图瘦身'}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Text '清理可确认的空白区块'}"
                                       Margin="0,3,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ReplacementNavigationButton" GroupName="MapFunctionSection" Click="ReplacementNavigation_Click" Style="{StaticResource MapFunctionNavigationStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text '方块替换'}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Text '全地图批量替换方块'}" Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ConversionNavigationButton"
                                 GroupName="MapFunctionSection"
                                 Click="ConversionNavigation_Click"
                                 Style="{StaticResource MapFunctionNavigationStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text '1.12.2 转换'}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Text '转换并导出高版本世界'}"
                                       Margin="0,3,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </RadioButton>

                    <Border Margin="0,12,0,0" Padding="11,9" CornerRadius="9" Background="#F3EFF8">
                        <TextBlock Text="{loc:Text '地图裁剪、地图瘦身和方块替换会原地重构世界文件。筑界镜不会自动备份，请在执行前手动备份并关闭 Minecraft 与服务端。'}"
                                   FontSize="10"
                                   Foreground="#756885"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="18,16">
                <ScrollViewer x:Name="ReplacementDetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{loc:Text '全地图方块替换'}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{loc:Text '全部维度 · 全部已保存区块（包含未加载区域）。直接修改原地图，保留地图版本。'}" Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        <Button x:Name="ScanReplacementButton" Content="{loc:Text '扫描地图方块'}" Click="ScanReplacement_Click" HorizontalAlignment="Left" IsEnabled="False" />
                        <Grid x:Name="ReplacementInputs" Margin="0,12,0,0" IsEnabled="False">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource MapFunctionSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text 'A · 要替换的方块（数量从多到少）'}" FontWeight="SemiBold" />
                                    <TextBox x:Name="ReplacementSourceSearch" Margin="0,8" Padding="6" ToolTip="{loc:Text '搜索方块名称或 Minecraft ID'}" TextChanged="ReplacementSearch_Changed" />
                                    <ListBox x:Name="ReplacementSourceList" Height="240" Style="{StaticResource ReplacementGridStyle}" SelectionChanged="ReplacementSelection_Changed" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MapFunctionSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="ReplacementTargetHeading" Text="{loc:Text 'B · 替换成'}" FontWeight="SemiBold" />
                                    <TextBox x:Name="ReplacementTargetSearch" Margin="0,8" Padding="6" ToolTip="{loc:Text '搜索方块名称或 Minecraft ID'}" TextChanged="ReplacementSearch_Changed" />
                                    <ListBox x:Name="ReplacementTargetList" Height="240" Style="{StaticResource ReplacementGridStyle}" SelectionChanged="ReplacementSelection_Changed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="ReplacementSummaryText" Text="{loc:Text '先扫描地图，再选择 A 和 B。可使用上方输入框搜索名称或 ID。'}" TextWrapping="Wrap" Foreground="#7651D2" Margin="0,6" />
                        <TextBlock x:Name="ReplacementTargetHelp" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,4,0,8" />
                        <Button x:Name="ApplyReplacementButton" Content="{loc:Text '确认数量并替换原地图'}" Click="ApplyReplacement_Click" IsEnabled="False" Background="{StaticResource AccentSoftBrush}" BorderBrush="#CDBCF6" />
                        <TextBlock x:Name="ReplacementStatusText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="CropDetailPanel"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{loc:Text '地图裁剪'}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{loc:Text '在顶层方块卫星图中选择矩形保留区；只裁剪当前维度。'}"
                                   Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,16,0,0" Style="{StaticResource MapFunctionNoticeStyle}">
                            <TextBlock Text="{loc:Text '会原地删除选区外的主区块、实体与 POI 数据；主世界选区必须包含出生点。'}"
                                       FontSize="10.5"
                                       Foreground="#8A5A18"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource MapFunctionSectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Text '当前状态'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="WorldCropSummaryText"
                                           Text="{loc:Text '原地删除选区外的主区块、实体与 POI 数据。不会自动创建备份；执行前请手动备份并关闭 Minecraft 与服务端。'}"
                                           Margin="0,7,0,0"
                                           FontSize="11.5"
                                           Foreground="#7651D2"
                                           TextWrapping="Wrap" />
                                <Grid x:Name="WorldCropProgressPanel" Visibility="Collapsed" Margin="0,13,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WorldCropProgressStageText"
                                               Text="{loc:Text '准备中'}"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="WorldCropProgressText"
                                               Grid.Column="1"
                                               Text="0%"
                                               Margin="10,0,0,0"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#7651D2" />
                                    <ProgressBar x:Name="WorldCropProgressBar"
                                                 Grid.Row="1"
                                                 Grid.ColumnSpan="2"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Margin="0,7,0,0"
                                                 Style="{StaticResource StellarProgressBarStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="OpenWorldCropButton"
                                Content="{loc:Text '打开卫星图裁剪器'}"
                                Click="OpenWorldCrop_Click"
                                IsEnabled="False"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                MinWidth="190"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="#CDBCF6" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SlimmingDetailPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{loc:Text '地图瘦身'}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{loc:Text '仅清理完全空白、无方块实体或活动数据的区块；自然地形一律保留。'}"
                                   Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,16,0,0" Style="{StaticResource MapFunctionNoticeStyle}">
                            <TextBlock Text="{loc:Text '这是保守型清理：无法确认安全的区块不会删除，因此带自然地形的空旷区域也会保留。'}"
                                       FontSize="10.5"
                                       Foreground="#8A5A18"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource MapFunctionSectionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text '判空并行数'}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="WorldSlimmingConcurrencyText"
                                           Grid.Column="1"
                                           Text="{loc:Text '4 路'}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#7651D2" />
                                <Slider x:Name="WorldSlimmingConcurrencySlider"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Minimum="1"
                                        Maximum="100"
                                        Value="4"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,9,0,0"
                                        ValueChanged="WorldSlimmingConcurrencySlider_ValueChanged" />
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource MapFunctionSectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Text '当前状态'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="WorldSlimmingSummaryText"
                                           Text="{loc:Text '请先分析当前地图。筑界镜不会自动创建备份；执行前请手动备份，并关闭 Minecraft 与服务端。'}"
                                           Margin="0,7,0,0"
                                           FontSize="11.5"
                                           Foreground="#7651D2"
                                           TextWrapping="Wrap" />
                                <Grid x:Name="WorldSlimmingProgressPanel" Visibility="Collapsed" Margin="0,13,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WorldSlimmingProgressStageText"
                                               Text="{loc:Text '准备中'}"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="WorldSlimmingProgressText"
                                               Grid.Column="1"
                                               Text="0%"
                                               Margin="10,0,0,0"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#7651D2" />
                                    <ProgressBar x:Name="WorldSlimmingProgressBar"
                                                 Grid.Row="1"
                                                 Grid.ColumnSpan="2"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Margin="0,7,0,0"
                                                 Style="{StaticResource StellarProgressBarStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Button x:Name="AnalyzeWorldSlimmingButton"
                                    Content="{loc:Text '分析可清理区块'}"
                                    Click="AnalyzeWorldSlimming_Click"
                                    IsEnabled="False"
                                    Margin="0,0,6,0" />
                            <Button x:Name="ApplyWorldSlimmingButton"
                                    Content="{loc:Text '执行瘦身'}"
                                    Click="ApplyWorldSlimming_Click"
                                    IsEnabled="False"
                                    Margin="6,0,0,0"
                                    Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="#CDBCF6" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ConversionDetailPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{loc:Text '1.12.2 转换'}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{loc:Text '将高版本 Minecraft 世界转换为可直接使用的 1.12.2 世界文件夹；Y 上移留空时自动计算。'}"
                                   Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,16,0,0" Style="{StaticResource MapFunctionNoticeStyle}">
                            <TextBlock x:Name="ConversionAvailabilityText"
                                       Text="{loc:Text '请先打开高于 1.12.2 的 Minecraft 世界。'}"
                                       FontSize="10.5"
                                       Foreground="#8A5A18"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource MapFunctionSectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Text '转换参数'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Text 'Y 上移'}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11.5" />
                                    <TextBox x:Name="ConversionYOffsetTextBox"
                                             Grid.Column="2"
                                             Height="34"
                                             Padding="9,6"
                                             Text=""
                                             ToolTip="{loc:Text '留空自动'}" />
                                </Grid>

                                <Button x:Name="ConversionExportButton"
                                        Content="{loc:Text '转换并导出世界'}"
                                        Click="ConversionExport_Click"
                                        IsEnabled="False"
                                        Margin="0,12,0,0"
                                        Padding="12,9"
                                        Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="#CDBCF6" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FCFBFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
            <Button x:Name="CancelTaskButton" Content="{loc:Text '取消任务'}" Click="CancelTask_Click" DockPanel.Dock="Right" Padding="10,2" Margin="6,2" Visibility="Collapsed"/>
            <TextBlock x:Name="WindowStatusText"
                       Text="{loc:Text '选择左侧工具后，在此窗口中完成额外操作。'}"
                       Margin="18,0"
                       VerticalAlignment="Center"
                       FontSize="10.5"
                       Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
