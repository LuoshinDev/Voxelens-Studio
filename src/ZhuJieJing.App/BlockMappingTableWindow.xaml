<Window x:Class="ZhuJieJing.App.BlockMappingTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZhuJieJing.App.Localization"
        Title="{loc:Text '1.12.2 方块映射表'}"
        Icon="Assets/ZhuJieJing.ico"
        Width="1040"
        Height="700"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="MappingCardStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Padding="11,9"
                                Background="#FFFFFF"
                                BorderBrush="#E9E1F3"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FAF7FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D4C3F3" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2EBFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#BFA3EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetTileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="#FAF8FD" />
            <Setter Property="BorderBrush" Value="#E4DCEB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="220" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F4EEFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#CBB5F0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A980E4" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#ECE2FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8F62D6" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="#F0E9FF" />
        </Style>

        <Style x:Key="BlockThumbnailFrameStyle" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="#F2EEF7" />
            <Setter Property="BorderBrush" Value="#E1D8EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="BlockThumbnailImageStyle" TargetType="Image">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
            <Style.Triggers>
                <Trigger Property="Source" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F7F5FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Border Background="#FCFBFF" BorderBrush="#E8E0F2" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Text '1.12.2 方块映射表'}" FontSize="18" FontWeight="SemiBold" Foreground="#342B47" />
                    <TextBlock Text="{loc:Text '检查内置替代规则，并为具体高版本方块指定更合适的 1.12.2 方块。'}"
                               Margin="0,4,0,0" FontSize="11.5" Foreground="#7A6C92" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ThumbnailLoadText"
                               Text="{loc:Text '正在载入方块图…'}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="#8A79A0"
                               Visibility="Collapsed" />
                    <Border Style="{StaticResource SmallPill}" VerticalAlignment="Center">
                        <TextBlock x:Name="MappingCountText" Text="{loc:Text '0 条映射'}" FontSize="11" FontWeight="SemiBold" Foreground="#6D43C6" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFF" BorderBrush="#E8E0F2" BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBox x:Name="MappingSearchBox" Height="36" Padding="31,7,10,7" TextChanged="MappingSearchBox_TextChanged" />
                        <Viewbox Width="14" Height="14" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Canvas Width="24" Height="24">
                                <Path Data="M10.5,4 A6.5,6.5 0 1 1 4,10.5 A6.5,6.5 0 0 1 10.5,4 Z M15.5,15.5 L21,21"
                                      Fill="Transparent" Stroke="#8C7BA3" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="MappingSearchHint" Text="{loc:Text '搜索高版本方块、目标方块或规则'}"
                                   Margin="32,0,0,0" VerticalAlignment="Center" Foreground="#A499B4" FontSize="11.5" IsHitTestVisible="False" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="1,10,1,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text '高版本方块 → 当前 1.12.2 替代'}" FontSize="11" Foreground="#7A6C92" VerticalAlignment="Center" />
                        <CheckBox x:Name="CurrentWorldOnlyCheckBox" Grid.Column="1" Content="{loc:Text '仅当前地图'}" Foreground="#685B7B"
                                  FontSize="11" VerticalAlignment="Center" Checked="MappingFilter_Changed" Unchecked="MappingFilter_Changed" />
                    </Grid>
                    <ListBox x:Name="MappingList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="MappingList_SelectionChanged"
                             ItemContainerStyle="{StaticResource MappingCardStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource BlockThumbnailFrameStyle}" ToolTip="{loc:Text '现代源方块'}">
                                            <Grid>
                                                <TextBlock Text="{loc:Text '源'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#A89BB7" />
                                                <Image Source="{Binding SourceThumbnail}" Style="{StaticResource BlockThumbnailImageStyle}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="→" Margin="5,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#9A89AD" />
                                        <Border Style="{StaticResource BlockThumbnailFrameStyle}" ToolTip="{loc:Text '当前 1.12.2 替代方块'}">
                                            <Grid>
                                                <Image Source="{Binding EffectiveTargetThumbnail}" Style="{StaticResource BlockThumbnailImageStyle}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourceTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#433654" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SourceKey}" Margin="0,2,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#94859F" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                            <TextBlock Text="{loc:Text '替代 '}" FontSize="9.5" Foreground="#9283A3" />
                                            <TextBlock Text="{Binding EffectiveTargetName}" FontSize="9.5" FontWeight="SemiBold" Foreground="#6D43C6" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="  " FontSize="9.5" />
                                            <TextBlock Text="{Binding EffectiveTargetEncodingText}" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#9A8DA7" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource SmallPill}" Visibility="{Binding UsageVisibility}">
                                            <TextBlock Text="{Binding UsageText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#6D43C6" />
                                        </Border>
                                        <TextBlock Text="{Binding OriginText}" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="9.5" Foreground="{Binding OriginBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E8E0F2" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid x:Name="EditorPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource BlockThumbnailFrameStyle}" ToolTip="{loc:Text '现代源方块'}">
                            <Grid>
                                <TextBlock Text="{loc:Text '源'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#A89BB7" />
                                <Image Source="{Binding SourceThumbnail}" Style="{StaticResource BlockThumbnailImageStyle}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Text '正在编辑'}" FontSize="9.5" Foreground="#8B7A9D" />
                            <TextBlock Text="{Binding SourceTitle}" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#3F3152" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SourceKey}" Margin="0,2,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#8A7A9D" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="RandomJumpButton"
                                Grid.Column="3"
                                Content="{loc:Text '随机查看位置'}"
                                MinWidth="108"
                                Height="30"
                                Margin="8,0,0,0"
                                Padding="9,4"
                                VerticalAlignment="Center"
                                Click="RandomJumpButton_Click"
                                ToolTip="{loc:Text '在当前地图中随机查找该高版本方块，并让 3D 视图跳转到它的实际坐标'}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="9,8" Background="#F9F7FC" BorderBrush="#EBE4F2" BorderThickness="1" CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" Style="{StaticResource BlockThumbnailFrameStyle}">
                                    <Grid>
                                        <Image Source="{Binding DefaultTargetThumbnail}" Width="38" Height="38" Style="{StaticResource BlockThumbnailImageStyle}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Text '内置规则'}" FontSize="9" Foreground="#9283A3" />
                                    <TextBlock Text="{Binding DefaultTargetName}" Margin="0,2,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#594A6D" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DefaultTargetDetail, Mode=OneWay}"
                                               Margin="0,2,0,0"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="8"
                                               Foreground="#9B8DA8"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Padding="9,8" Background="#F6F0FF" BorderBrush="#DECEF8" BorderThickness="1" CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" Style="{StaticResource BlockThumbnailFrameStyle}">
                                    <Grid>
                                        <Image Source="{Binding EffectiveTargetThumbnail}" Width="38" Height="38" Style="{StaticResource BlockThumbnailImageStyle}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Text '当前采用'}" FontSize="9" Foreground="#896DB2" />
                                    <TextBlock Text="{Binding EffectiveTargetName}" Margin="0,2,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#653EB5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding EffectiveTargetDetail, Mode=OneWay}"
                                               Margin="0,2,0,0"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="8"
                                               Foreground="#967FB9"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="RandomJumpStatusText"
                               Grid.Row="2"
                               Visibility="Collapsed" />

                    <Grid Grid.Row="3" Margin="0,13,0,8">
                        <TextBox x:Name="TargetSearchBox" Height="34" Padding="10,6" TextChanged="TargetSearchBox_TextChanged" />
                        <TextBlock x:Name="TargetSearchHint" Text="{loc:Text '搜索 1.12.2 方块名称或 Minecraft ID'}"
                                   Margin="11,0,0,0" VerticalAlignment="Center" Foreground="#A499B4" FontSize="11" IsHitTestVisible="False" />
                    </Grid>

                    <ListBox x:Name="TargetList"
                             Grid.Row="4"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource TargetRowStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TargetTileButtonStyle}"
                                                    Click="TargetTile_Click">
                                                <Button.ToolTip>
                                                    <ToolTip Padding="10,8">
                                                        <StackPanel MaxWidth="320">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#433654" />
                                                            <TextBlock Text="{Binding MaterialIdentifier}" Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="9.5" Foreground="#78698A" TextWrapping="Wrap" />
                                                            <TextBlock Text="{loc:Text '朝向、开合等状态会自动跟随源方块；单击即时采用'}"
                                                                       Margin="0,6,0,0" FontSize="9.5" Foreground="#9A8DA7" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Width="46" Height="46" Stretch="Uniform"
                                                           SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <UniformGrid Grid.Row="5" Columns="2" Margin="0,10,0,0">
                        <Button x:Name="RestoreDefaultButton" Content="{loc:Text '恢复内置规则'}" Click="RestoreDefaultButton_Click" Margin="0,0,5,0" />
                        <Button x:Name="UseSelectedTargetButton" Content="{loc:Text '使用选中方块'}" Click="UseSelectedTargetButton_Click" Margin="5,0,0,0" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FCFBFF" BorderBrush="#E8E0F2" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ChangeSummaryText" Text="{loc:Text '未修改'}" VerticalAlignment="Center" FontSize="11" Foreground="#7A6C92" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Text '取消'}" Click="CancelButton_Click" MinWidth="84" Margin="0,0,8,0" />
                    <Button Content="{loc:Text '保存并应用'}" Click="SaveButton_Click" MinWidth="108" Style="{StaticResource ExportButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
